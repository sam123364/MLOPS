# Python cache & compiled
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/
.conda/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db
desktop.ini

# DVC — data is versioned by DVC, not Git
/data/raw/
/data/interim/
/data/processed/
/data/external/
*.dvc
!.dvcignore

# Geospatial auxiliary files (auto-generated by GDAL)
*.ovr
*.aux.xml
*.msk
*.lock
*.prj

# MLflow run artifacts (tracked in mlruns by MLflow, not committed)
mlruns/

# Large binary / raster files
*.bin
*.tif
*.tiff
*.nc
*.hdf
*.h5
*.zip
*.gz
*.tar
*.gzip

# Secrets & credentials (never commit these)
.env
*.env.*
credentials.json
service_account.json
secrets.yaml

# Reports (generated; optionally track specific outputs)
reports/figures/
!reports/.gitkeep

# Logs
*.log
logs/

# Temporary / scratch
tmp/
scratch/
